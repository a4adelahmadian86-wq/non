# FARAST production environment template.
# Copy to .env on the server, then replace every placeholder through the host's
# secret manager. Never commit a real .env file or copy production secrets into CI logs.

APP_NAME=FARAST
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Tehran

LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Primary database: mysql (default) or pgsql. SQLite is intended for tests/local use.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=farast
DB_USERNAME=farast
DB_PASSWORD=
DB_SOCKET=
MYSQL_ATTR_SSL_CA=

# Initial administrator: set only for the first controlled seed, then remove these values.
ADMIN_MOBILE=
ADMIN_INITIAL_PASSWORD=
FARAST_ADMIN_PASSWORD=

# Database-backed cache, sessions and queue.
CACHE_STORE=database
CACHE_PREFIX=farast_cache
SESSION_DRIVER=database
SESSION_COOKIE=farast_session
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
# true: cron-only/shared hosting drains queues through stop-when-empty workers each minute.
# false: only after dedicated database/default and backups workers are supervised by the host.
QUEUE_SCHEDULED_WORKER=true
DB_QUEUE_CONNECTION=

FILESYSTEM_DISK=private

# Configure a real SMTP provider before enabling production email delivery.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=8
MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs -i
MAIL_LOG_CHANNEL=stack
MAIL_FROM_ADDRESS=noreply@your-domain.example
MAIL_FROM_NAME=FARAST

# Required for encrypted backups. Generate independently per environment:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
FARAST_BACKUP_ENCRYPTION_KEY=
FARAST_ENABLE_IRAN_BACKUP=false
FARAST_STORAGE_CONNECT_TIMEOUT=8
FARAST_STORAGE_REQUEST_TIMEOUT=300

# Live assistant gateway. FARAST_VOICE_TOKEN must match the Voice-typing service secret.
FARAST_AI_GATEWAY_URL=https://voice-typing-r5r7.onrender.com
FARAST_VOICE_TOKEN=
FARAST_AI_GATEWAY_MODEL=farast-general
FARAST_VOICE_LOCAL_SPEECH_ENABLED=false
FARAST_VOICE_REMOTE_BATCH_ENABLED=true
FARAST_VOICE_ASR_URL=https://voice-typing-r5r7.onrender.com/v1/transcribe
FARAST_VOICE_TTS_URL=https://voice-typing-r5r7.onrender.com/v1/synthesize
FARAST_VOICE_TTS_VOICE_ID=farast-fa-male-v1
VOICE_STREAM_URL=wss://voice-typing-r5r7.onrender.com
VOICE_STREAM_HEALTH_URL=
VOICE_GATEWAY_SECRET=

# Isolated product and document processing services. Leave URLs empty when disabled.
FARAST_PRODUCT_SUPERVISOR_URL=
FARAST_PRODUCT_SUPERVISOR_TOKEN=
FARAST_PRODUCT_SUPERVISOR_TIMEOUT=40
FARAST_PRODUCT_SUPERVISOR_FILE_TIMEOUT=540
FARAST_DOCUMENT_AUDIO_URL=
FARAST_DOCUMENT_AUDIO_TOKEN=

# AI provider credentials. Keep these server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
FILES_API_KEY=
PROVIDER_HEALTH_FRESHNESS_SECONDS=86400

# Optional Google Speech integration.
GOOGLE_SPEECH_ENABLED=false
GOOGLE_SPEECH_CREDENTIALS_FILE=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# SMS / OTP provider.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_TPL_TICKET_REPLY=
KAVENEGAR_TPL_TICKET_CLOSED=
KAVENEGAR_TPL_TICKET_ASSIGNED=
KAVENEGAR_TPL_TICKET_CREATED_STAFF=
KAVENEGAR_TPL_TICKET_CUSTOMER_REPLY=
KAVENEGAR_TPL_SLA_WARNING=
KAVENEGAR_TPL_SLA_BREACH=

# Support service levels and business calendar.
SUPPORT_SLA_HIGH=60
SUPPORT_SLA_NORMAL=240
SUPPORT_SLA_LOW=1440
SUPPORT_RESOLVE_HIGH=480
SUPPORT_RESOLVE_NORMAL=1440
SUPPORT_RESOLVE_LOW=4320
SUPPORT_SLA_BUSINESS_HOURS=true
SUPPORT_BH_START=9
SUPPORT_BH_END=18
SUPPORT_WEEKEND=4,5
SUPPORT_SLA_WARN_BEFORE=30
SUPPORT_SLA_MONITOR=true

# Admin, upload and observability controls.
FARAST_ADMIN_SCOPE_KEY=
FARAST_ADMIN_MULTI_ROLE=true
FARAST_MAX_UPLOAD_BYTES=2147483648
FARAST_MAX_TOOL_INPUT_BYTES=52428800
FARAST_OBSERVABILITY_ENABLED=true
FARAST_EVALUATION_MAX_REGRESSION=0.05
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12
