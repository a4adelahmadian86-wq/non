# Publicly reachable interface for a separately hosted WebSocket service.
VOICE_STREAM_HOST=0.0.0.0
VOICE_STREAM_PORT=6002
# Comma-separated exact origins of the Laravel site that serves the editor.
VOICE_STREAM_ORIGINS=https://your-laravel-domain.example,http://127.0.0.1:8001,http://localhost:8001
VOICE_STREAM_APP_URL=https://your-laravel-domain.example
VOICE_STREAM_RESTART_MS=270000

# Must match Laravel APP_KEY exactly; used only to verify short-lived session tokens.
APP_KEY=base64:replace-with-the-exact-laravel-app-key
# Must match Laravel VOICE_GATEWAY_SECRET exactly; used for server-to-server provider config.
VOICE_GATEWAY_SECRET=replace-with-the-exact-laravel-voice-gateway-secret

GOOGLE_CLOUD_PROJECT=
GOOGLE_SPEECH_REGION=us
GOOGLE_APPLICATION_CREDENTIALS=

# Local-only Sherpa-ONNX streaming ASR sidecar (Persian fa-IR).
# Keep this bound to loopback or a private network; never expose it publicly.
SHERPA_ONNX_WS_URL=ws://127.0.0.1:6006
# Exact private Docker/service DNS names only; leave empty when using loopback.
SHERPA_ONNX_ALLOWED_HOSTS=
