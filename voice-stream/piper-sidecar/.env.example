# Bind to loopback when Laravel and Piper share a host.
# If using containers, use 0.0.0.0 only on a private container network.
PIPER_HOST=127.0.0.1
PIPER_PORT=7007
PIPER_MODEL_DIR=/opt/farast/models/piper
# Generate a long random secret. Set the same value as Laravel FARAST_VOICE_TTS_TOKEN.
PIPER_TTS_TOKEN=replace-with-at-least-32-random-characters
