# Reuse the existing FARAST_VOICE_TOKEN already configured for FARAST; keep both sides identical.
# Do not rotate an existing production token just to enable this service.
FARAST_VOICE_TOKEN=use-existing-farast-voice-token

# Required for short-lived Laravel-signed WebSocket session tokens; exact Laravel APP_KEY.
APP_KEY=base64:replace-with-the-exact-laravel-app-key
# Exact browser Origin(s) of the local/deployed Laravel site; comma-separated.
VOICE_STREAM_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Canonical Laravel URL and shared gateway secret for quota reservation/settlement.
FARAST_APP_URL=http://127.0.0.1:8000
FARAST_VOICE_GATEWAY_SECRET=replace-with-the-same-VOICE_GATEWAY_SECRET-from-Laravel

# Whisper CPU profile. "small" is a quality/resource compromise, not a performance guarantee.
FARAST_ASR_MODEL=small
FARAST_ASR_DEVICE=cpu
FARAST_ASR_COMPUTE_TYPE=int8
FARAST_ASR_CPU_THREADS=2
FARAST_MAX_AUDIO_BYTES=15728640
FARAST_MAX_TEXT_CHARS=1200
# A persistent WebSocket session is capped at 30 minutes; reopen for a fresh quota reservation.
FARAST_MAX_STREAM_SECONDS=1800

# Install/download the exact single-speaker Persian VITS checkpoint and config on persistent storage.
# Do not change the voice model after launch unless you intentionally version the voice.
FARAST_VOICE_ID=farast-fa-male-v1
FARAST_TTS_MODEL_PATH=/models/persian-tts-male-vits/best_model_91323.pth
FARAST_TTS_CONFIG_PATH=/models/persian-tts-male-vits/config.json

# Downloads the pinned Persian male VITS checkpoint (~1 GB) into persistent /models on first boot.
FARAST_TTS_AUTO_DOWNLOAD=true
FARAST_TTS_MODEL_REPO=Kamtera/persian-tts-male-vits
