# Generate independent random values. Never commit real tokens.
FARAST_NETLIFY_GATEWAY_TOKEN=replace-with-a-long-random-token

# Exact HTTPS origin of the deployed FARAST Cloudflare AI Worker (no path/query).
FARAST_CLOUDFLARE_AI_GATEWAY_URL=https://your-worker.workers.dev
FARAST_CLOUDFLARE_AI_GATEWAY_TOKEN=replace-with-the-worker-token
