# Required: dedicated token used by the Laravel ProductSupervisorClient.
SUPERVISOR_API_TOKEN=

# Set true only on the domestic Runflare fallback node. This disables all
# external model calls and returns manual-review results instead of approval.
SUPERVISOR_OFFLINE_MODE=false

# Preferred free inference provider. Create a scoped Cloudflare API token with
# AI Gateway Read + Edit and Workers AI Read permissions; keep secrets only in the worker's environment.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=default
CLOUDFLARE_TEXT_MODEL=@cf/openai/gpt-oss-20b
CLOUDFLARE_VISION_MODEL=@cf/moondream/moondream3.1-9B-A2B
CLOUDFLARE_AUDIO_MODEL=@cf/openai/whisper-large-v3-turbo

# Optional fallbacks. Groq file analysis is disabled unless ZDR is confirmed.
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_ZDR_CONFIRMED=false
