# Required: dedicated token used by the Laravel ProductSupervisorClient.
SUPERVISOR_API_TOKEN=

# Product Supervisor calls only the authenticated FARAST Worker gateway.
# The Cloudflare account ID and model-provider token stay inside the Worker.
FARAST_AI_GATEWAY_URL=
FARAST_AI_GATEWAY_TOKEN=

# Optional fallback for product metadata only. Leave empty by default.
GEMINI_API_KEY=

# Optional file-analysis fallback is disabled unless account-level ZDR is verified.
GROQ_API_KEY=
GROQ_ZDR_CONFIRMED=false

# Resource limits for Runflare's free container.
MAX_CONCURRENT_FILE_REVIEWS=1
MAX_UPLOAD_BYTES=26214400
